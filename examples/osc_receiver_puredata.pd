#N canvas 100 100 700 500 10;
#X obj 50 50 udpreceive 9000;
#X obj 50 80 oscparse;
#X obj 50 110 list trim;
#X obj 50 140 route /sukumo;
#X obj 50 170 route temperature electrode ph orp do;
#X obj 50 220 print temperature;
#X obj 200 220 route /sfc_w /sfc_e /sfc_n /sfc_s /mid_n /mid_s /btm_n /btm_s;
#X obj 200 270 print electrode;
#X obj 50 320 print ph;
#X obj 150 320 print orp;
#X obj 250 320 print do;
#X text 350 50 Listens for /sukumo/* OSC messages on port 9000.;
#X text 350 70 Replace 'print' boxes with your own logic to actually \, do something.;
